# DeployBar 배포 설정 — 이 파일이 이 앱의 배포 규칙 전부다.
# 참고: DeployBar/README.md 의 "앱 쪽 규칙" 표

# 필수: archive 할 scheme.
# 폴더 이름(돈꼬마트)과 scheme 이름(DontGoMart)이 달라서 반드시 적어 둬야 한다.
SCHEME=DontGoMart

PLATFORM=ios

# 버전·빌드번호의 단일 소스.
# 주의: 타겟 빌드 설정에도 MARKETING_VERSION 이 직접 박혀 있어(6곳) xcconfig 를 덮는다.
# 버전을 올릴 때는 project.pbxproj 쪽도 같이 고쳐야 한다.
VERSION_XCCONFIG=Config/Version.xcconfig

# 배포 전 게이트. 실패하면 아카이브를 만들지 않는다.
PREDEPLOY_SCRIPT=scripts/predeploy.sh

# App Store 에 등록한 언어 — 다국어 게이트 기준이자 릴리즈노트를 만들 언어.
LOCALES=ko,en

# 다국어 게이트: strict | warn | off
# 2.0.7 에서 ko/en 구멍을 0 으로 만들어 strict 로 올렸다.
# (이모지·포맷 전용 키도 영어 항목을 명시해 두었다 — 값은 키와 같다)
LOCALIZATION_GATE=strict

# 릴리즈노트 게이트: 빈 노트로 나간 버전은 되돌릴 수 없다.
# 원고는 레포 최상단 RELEASE_NOTES.md 의 `## <버전>` 절에 쓴다.
RELEASE_NOTES_GATE=strict
